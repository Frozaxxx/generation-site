# --- App ---
APP_NAME="Generation Site"
APP_PORT=8000
APP_VERSION="0.1.0"
APP_CORS_ORIGINS='["http://localhost:5173"]'

# --- OpenRouter ---
# Ключ хранится только на сервере: не попадает в ответы API, логи и готовые сайты.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TEXT_MODEL="google/gemini-2.5-flash"
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image"
OPENROUTER_MAX_RETRIES=3
OPENROUTER_REQUEST_TIMEOUT=120
# Лимит расходов на одну операцию (генерация компании или сайта), USD
OPENROUTER_OPERATION_BUDGET_USD=1.0

# --- Storage ---
# По умолчанию backend/data: SQLite, фото команды, собранные сайты
# STORAGE_DATA_DIR="./data"
# DATABASE_URL="sqlite+aiosqlite:///./data/app.sqlite3"
DATABASE_ECHO=false
